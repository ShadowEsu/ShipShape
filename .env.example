# Names only. Real values live in the deployment's secret store or a git-ignored .env.local.

# Postgres (Supabase pooler or RDS), connecting as the login role shipshape_app: never the master
# user or postgres, never a superuser or BYPASSRLS role. Leave empty locally to use PGlite.
DATABASE_URL=

# The database provider's CA bundle (PEM): RDS's regional bundle or Supabase's CA. The certificate
# and hostname are always verified; without this, Node's built-in CAs apply.
DATABASE_CA_CERT=

# File storage. Unset locally: files go under .data/blobs. Production: the private S3 bucket, reached with
# Vercel's OIDC token for AWS_ROLE_ARN (no stored AWS keys). Set AWS_REGION explicitly (us-east-1).
SHIPSHAPE_S3_BUCKET=
AWS_REGION=
AWS_ROLE_ARN=
# Local S3 stand-in only (e.g. http://127.0.0.1:5917); refused in production, as is any AWS_ENDPOINT_URL*
# (and production ignores endpoint_url in AWS config files): AWS calls go to AWS only.
SHIPSHAPE_S3_ENDPOINT=

# 32 random bytes, base64: encrypts EINs and SSNs. Generate: openssl rand -base64 32
SHIPSHAPE_FIELD_KEY=

# At least 32 characters: signs session cookies. Generate: openssl rand -base64 48
SHIPSHAPE_SESSION_SECRET=

# At least 32 characters, separate from the session secret: keys IP hashes for rate limits.
SHIPSHAPE_HASH_KEY=

# Security gate G3. Leave unset in production until Security's GO; set to 1 for local development.
SHIPSHAPE_REAL_DOCS=

# The app's look: unset is the redesigned app (sidebar of tools, the AI box first, motion); v1 brings back the earlier look.
SHIPSHAPE_UI=

# Public contact address: /privacy lists it and shared pages link "Report this page" to it. Production
# with SHIPSHAPE_REAL_DOCS=1 refuses to start without it.
CONTACT_EMAIL=

# Bearer secret the scheduler sends to /api/cron/reminders (at least 32 characters). Unset: the route answers 503.
CRON_SECRET=

# Public base URL of this deployment, no trailing slash (Stripe return URLs, the sign-in callback, the sitemap and link-preview image URLs), e.g. http://127.0.0.1:3917
SHIPSHAPE_APP_URL=

# Search engines (optional, production only). The content value of Google Search Console's "HTML tag" verification,
# Bing Webmaster Tools' msvalidate.01 value, and an IndexNow key (8-128 letters, digits or '-'; served at /indexnow.txt
# and used by scripts/indexnow.mjs). None of them is a secret.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# Account sign-in (Amazon Cognito user pool, managed login). Leave all four empty: the sign-in page
# offers the sample workspace only. Set all four or none. The app client is confidential (has a
# secret), uses the authorization code grant with scopes openid and email, and lists exactly
# <SHIPSHAPE_APP_URL>/auth/callback as its callback URL. Deleting an account deletes its Cognito user
# with AWS_ROLE_ARN's credentials (above), so in production that role needs AdminDeleteUser on the pool.
COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Billing switch: payments (Checkout, the billing portal, the Stripe webhook) run only while this is 1 and the
# Stripe values below are set. Off by default; the webhook answers 503 while it's off.
BILLING_ENABLED=
# Stripe: previews, local runs and CI take only an sk_test_/rk_test_ key. Vercel's Production takes only a restricted
# rk_live_ key, with SHIPSHAPE_CHECKOUT_LIVE=1 (exactly), final terms and real documents on; Preston sets the key and
# this flag himself, the flag last (PRESTON-STRIPE-LIVE.md). Anything else switches billing off.
SHIPSHAPE_CHECKOUT_LIVE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The $15/month Pro price (price_...). Checkout refuses to start if Stripe's amount differs from lib/plans.ts.
STRIPE_PRICE_PRO=
# Optional: a billing portal configuration (bpc_...); Stripe's default is used when empty.
STRIPE_PORTAL_CONFIG=
# Optional: 1 adds Stripe Tax to the checkout (turn Stripe Tax on in the Dashboard first); the pages then say tax is added.
STRIPE_AUTOMATIC_TAX=
# Optional: 1 (exactly) stops new Pro checkouts only; the webhook, the billing portal and account deletion keep working
# for people who already pay, and /api/health says "checkout":"paused". The gentle rollback (PRESTON-STRIPE-LIVE.md, G).
SHIPSHAPE_CHECKOUT_PAUSED=

# AI (Security gate G4). Kill switch: AI runs only while this is 1 and a key is set.
SHIPSHAPE_AI=
# Production: the Anthropic key, server-only (never NEXT_PUBLIC_). Set through the host's secret store.
ANTHROPIC_API_KEY=
# Local development only: path to a file holding one NAME=value line with the key, read at every call (keys rotate).
ANTHROPIC_API_KEY_FILE=
