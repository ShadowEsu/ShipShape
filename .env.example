# Names only. Real values live in the deployment's secret store or a git-ignored .env.local.

# Postgres (Supabase pooler URL in production). Leave empty locally to use PGlite in .data/pglite.
DATABASE_URL=

# 32 random bytes, base64: encrypts EINs and SSNs. Generate: openssl rand -base64 32
SHIPSHAPE_FIELD_KEY=

# At least 32 characters: signs session cookies and keys rate-limit hashes. Generate: openssl rand -base64 48
SHIPSHAPE_SESSION_SECRET=
