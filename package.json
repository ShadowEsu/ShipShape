{
  "name": "shipshape",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "migrate": "node scripts/migrate.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check-sql.mjs && node scripts/check-pdf-load.mjs",
    "test": "vitest run",
    "test:s3": "SHIPSHAPE_S3_TEST_ENDPOINT=http://127.0.0.1:5917 vitest run tests/blob-store.test.ts",
    "eval:ai": "vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@electric-sql/pglite": "0.5.13",
    "@vercel/oidc-aws-credentials-provider": "3.3.17",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "3.1161.0",
    "@aws-sdk/client-rds": "3.1161.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
