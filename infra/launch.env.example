# The 8 settings infra/launch.sh needs. Copy this file to infra/launch.env (git-ignored) and fill in
# every line; 2 come filled in. No secrets go here: passwords and the client secret stay in AWS and Vercel.
# Then check them with: infra/launch.sh --dry-run

# The AWS CLI profile of your Identity Center session: the name you gave aws configure sso,
# the same one you sign in with (aws sso login --profile NAME).
AWS_PROFILE=

# Your 12-digit AWS account id (the AWS console shows it under your name, top right).
ACCOUNT_ID=

# Everything runs in us-east-1 (aws-plan.md). Leave it.
AWS_REGION=us-east-1

# The production address: https, lowercase, no path or trailing slash, e.g. https://app.example.com.
# It becomes SHIPSHAPE_APP_URL and the sign-in callback (APP_URL/auth/callback).
APP_URL=

# The Vercel team slug: the part after vercel.com/ on the team's dashboard. Its OIDC issuer is
# https://oidc.vercel.com/TEAM, so the app role trusts only this team.
VERCEL_TEAM=

# The Vercel project's name. Only its production environment may use the app role.
VERCEL_PROJECT=shipshape

# The sign-in page's address: https://PREFIX.auth.us-east-1.amazoncognito.com. Lowercase letters,
# digits and hyphens; it can't contain aws, amazon or cognito, and nobody else may be using it.
COGNITO_DOMAIN_PREFIX=

# Who gets both budget alarms: the account owner's own address.
ALERT_EMAIL=
